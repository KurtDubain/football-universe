{
  "name": "football-universe",
  "private": true,
  "version": "4.56.1",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:audit": "VITE_ENABLE_AUDIT=true pnpm build",
    "audio:check": "tsx scripts/check-audio-assets.ts",
    "bundle:check": "tsx scripts/check-bundle-size.ts",
    "changelog:check": "tsx scripts/check-changelog.ts",
    "docs:check": "tsx scripts/check-current-docs.ts",
    "music:generate": "tsx scripts/generate-tournament-music.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "screenshots": "tsx scripts/screenshot.ts",
    "scripts:check": "tsx scripts/check-portable-scripts.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -b",
    "audit:current": "tsx scripts/audit-e2e.ts",
    "audit:advance-performance": "tsx scripts/audit-advance-performance.ts",
    "audit:animation-performance": "tsx scripts/audit-animation-performance.ts",
    "audit:long-save": "tsx scripts/audit-long-save.ts",
    "audit:observer-seeds": "tsx scripts/audit-observer-seeds.ts",
    "audit:storylines": "tsx scripts/audit-storyline-frequency.ts",
    "audit:narrative": "tsx scripts/audit-narrative-director.ts",
    "audit:player-defense": "tsx scripts/audit-player-defense.ts",
    "audit:player-performance": "tsx scripts/audit-player-performance.ts",
    "audit:coach-stars": "tsx scripts/audit-coach-stars.ts",
    "verify:match": "tsx scripts/verify-match-presentation.ts",
    "verify:match-playback": "tsx scripts/verify-match-playback-sync.ts",
    "verify:match-shootout": "tsx scripts/verify-match-shootout.ts",
    "verify:match-set-pieces": "tsx scripts/verify-match-set-pieces.ts",
    "verify:match-tactics": "tsx scripts/verify-match-tactics.ts",
    "verify:match-openers": "tsx scripts/verify-match-openers.ts",
    "verify:broadcast-experience": "tsx scripts/verify-broadcast-experience.ts",
    "verify:match-explanation": "tsx scripts/verify-match-explanation.ts",
    "verify:floating-advance": "tsx scripts/verify-floating-advance.ts",
    "verify:ui-foundation": "tsx scripts/verify-ui-foundation.ts",
    "verify:mobile-routes": "tsx scripts/verify-mobile-routes.ts",
    "verify:cup-bracket": "tsx scripts/verify-cup-bracket.ts",
    "verify:tournament-music": "tsx scripts/verify-tournament-music.ts",
    "verify:world-cup-experience": "tsx scripts/verify-world-cup-experience.ts",
    "verify:feedback": "tsx scripts/verify-feedback.ts",
    "verify:pwa-update": "tsx scripts/verify-pwa-update.ts",
    "verify:pwa-transition": "tsx scripts/verify-pwa-deployment-transition.ts",
    "verify:route-recovery": "tsx scripts/verify-route-recovery.ts",
    "verify:visual-assets": "tsx scripts/verify-visual-assets.ts",
    "verify:history-summary": "tsx scripts/verify-history-summary.ts",
    "verify:dashboard": "tsx scripts/verify-dashboard-workflow.ts",
    "verify:player-team": "tsx scripts/verify-player-team-workflow.ts",
    "verify:player-performance": "tsx scripts/verify-player-performance.ts",
    "verify:club-story": "tsx scripts/verify-club-story-workflow.ts",
    "verify:observer-foundation": "tsx scripts/verify-observer-foundation.ts",
    "verify:observer-onboarding": "tsx scripts/verify-observer-onboarding.ts",
    "verify:observation-judgment": "tsx scripts/verify-observation-judgment.ts",
    "verify:storyline-signals": "tsx scripts/verify-storyline-signals.ts",
    "verify:world-response": "tsx scripts/verify-world-response.ts",
    "verify:narrative-director": "tsx scripts/verify-narrative-director.ts",
    "verify:key-node": "tsx scripts/verify-key-node-time-control.ts",
    "verify:time-controls": "tsx scripts/verify-season-flow-controls.ts",
    "verify:observation-route": "tsx scripts/verify-observation-theme-route.ts",
    "verify:observation-archive": "tsx scripts/verify-observation-theme-archive.ts",
    "verify:dashboard-focus": "tsx scripts/verify-dashboard-observation-focus.ts",
    "verify:smoke": "pnpm build:audit && tsx scripts/run-browser-audit-suite.ts smoke",
    "verify:full": "pnpm build:audit && tsx scripts/run-browser-audit-suite.ts full"
  },
  "dependencies": {
    "i18next": "^26.1.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
